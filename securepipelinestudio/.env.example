# Public site path. Use / for local preview. GitHub Pages project sites use /<repository>/.
VITE_BASE_PATH=/

# Optional. Both values are required before the app creates a Supabase client.
# They are embedded in the static build and are public. Never put a service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
